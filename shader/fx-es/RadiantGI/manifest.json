    "ui_step": [
     1
    ],
    "ui_label": "General Ray Length",
    "ui_tooltip": "General GI Ray Length is used to increase the Sampling Radius.\nThe byproduc of this causes the ray casting distance to extend.\nThis scales automatically with multi level detail.",
    "ui_category": "Global Illumination"
   }
  },
  {
   "name": "Target_Lighting",
   "offset": 12,
   "size": 4,
   "rows": 1,
   "cols": 1,
   "base": 7,
